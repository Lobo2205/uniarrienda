# Copia este archivo como .env y cambia TU_CLAVE por la contraseña del usuario postgres
DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/uniarrienda
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta
JWT_MINUTOS=1440
# URL con la que Flutter y React llegan al backend. Para el celular usa la IP de tu PC, ej. http://192.168.1.10:8000
URL_PUBLICA=http://localhost:8000
